{
  "name": "bitbounce",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:content": "vitest run --project unit tests/content-provenance.test.ts tests/content-loader.test.ts",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "goldens:update": "UPDATE_GOLDENS=1 vitest run tests/golden && UPDATE_GOLDENS=1 vitest run --project browser tests/browser/render-fingerprint.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "fuzz": "node scripts/fuzz.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=bitbounce --branch=main"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "midi-file": "^1.2.4",
    "solid-js": "^1.9.15",
    "valibot": "^1.4.2",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tonejs/midi": "^2.0.28",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
